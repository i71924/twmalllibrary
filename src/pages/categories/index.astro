---
import Base from '../../layouts/Base.astro';
import { db } from '../../lib/data';

const { categories, brands, locationsByBrand } = db();
// 只算目前有營業中櫃位的品牌
const active = brands.filter((b) => (locationsByBrand.get(b.id)?.length ?? 0) > 0);
const count = (code: string) => active.filter((b) => b.category === code || b.category?.startsWith(code + '.')).length;
const classified = active.filter((b) => b.category).length;
const pct = Math.floor((classified / active.length) * 100);
---

<Base title="業種分類" description="依業種瀏覽品牌：餐飲、時尚、美妝、運動、親子、生活家居等。">
  <h1 class="mb-2 mt-8 text-3xl font-black">業種分類</h1>
  <p class="mb-6 text-muted">
    {active.length.toLocaleString()} 個品牌中，{pct}% 已分類；其餘多是期間限定店或官網沒有介紹的櫃位。
  </p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      categories.map((c) => (
        <section id={c.code} class="scroll-mt-24 rounded-3xl border border-line bg-card p-5 transition hover:border-brand">
          <h2 class="mb-3 text-lg font-black">
            <a href={`/categories/${c.code}/`} class="flex items-center gap-2 hover:text-brand">
              <span class="text-2xl">{c.icon}</span>
              {c.name}
              <span class="ml-auto text-sm font-normal text-muted">{count(c.code)} 個品牌 ›</span>
            </a>
          </h2>
          <ul class="flex flex-wrap gap-1.5 text-sm">
            {c.children.map((ch) => (
              <li>
                <a href={`/categories/${ch.code}/`} class="block rounded-full bg-paper px-3 py-1 hover:bg-brand-soft hover:text-brand">
                  {ch.name} <span class="text-muted">{count(ch.code)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
