---
import Base from '../../layouts/Base.astro';
import MallCard from '../../components/MallCard.astro';
import { CITY_ORDER, MALL_TYPE, db } from '../../lib/data';

const { malls } = db();
const cities = CITY_ORDER.filter((c) => malls.some((m) => m.city === c));
const types = Object.entries(MALL_TYPE).filter(([t]) => malls.some((m) => m.type === t));
---

<Base title="全台商場" description="依縣市與類型瀏覽全台百貨公司、購物中心、Outlet。">
  <h1 class="mb-2 mt-8 text-3xl font-black">全台商場</h1>
  <p class="mb-6 text-muted">共 <b id="count">{malls.length}</b> 個商場</p>

  <div class="mb-6 space-y-3">
    <div class="flex flex-wrap gap-2" data-filter="city">
      <button data-v="" class="chip is-on">全部縣市</button>
      {cities.map((c) => <button data-v={c} class="chip">{c}</button>)}
    </div>
    <div class="flex flex-wrap gap-2" data-filter="type">
      <button data-v="" class="chip is-on">全部類型</button>
      {types.map(([t, label]) => <button data-v={t} class="chip">{label}</button>)}
    </div>
  </div>

  <div id="grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{malls.map((m) => <MallCard mall={m} />)}</div>
</Base>

<style>
  @reference "../../styles/global.css";
  .chip {
    @apply cursor-pointer rounded-full border border-line bg-card px-4 py-1.5 text-sm transition hover:border-brand;
  }
  .chip.is-on {
    @apply border-brand bg-brand text-white;
  }
</style>

<script>
  const state: Record<string, string> = { city: new URLSearchParams(location.search).get('city') ?? '', type: '' };
  const cards = [...document.querySelectorAll<HTMLElement>('#grid > a')];
  function apply() {
    let n = 0;
    for (const c of cards) {
      const show = (!state.city || c.dataset.city === state.city) && (!state.type || c.dataset.type === state.type);
      c.hidden = !show;
      if (show) n++;
    }
    document.getElementById('count')!.textContent = String(n);
    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((g) =>
      g.querySelectorAll<HTMLElement>('button').forEach((b) => b.classList.toggle('is-on', b.dataset.v === state[g.dataset.filter!])),
    );
  }
  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((g) =>
    g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      state[g.dataset.filter!] = b.dataset.v ?? '';
      apply();
    }),
  );
  apply();
</script>
