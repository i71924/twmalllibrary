---
import Base from '../../layouts/Base.astro';
import BrandAvatar from '../../components/BrandAvatar.astro';
import { CITY_ORDER, db, type Location } from '../../lib/data';
import type { Brand } from '../../lib/schema';

export function getStaticPaths() {
  return db().brands.map((brand) => ({ params: { id: brand.id }, props: { brand } }));
}
const { brand } = Astro.props as { brand: Brand };
const { locationsByBrand, categoryName, agents } = db();
const locations = locationsByBrand.get(brand.id) ?? [];
const byCity = new Map<string, Location[]>();
for (const l of locations) byCity.set(l.mall.city, [...(byCity.get(l.mall.city) ?? []), l]);
const cities = [...byCity.keys()].sort((a, b) => CITY_ORDER.indexOf(a) - CITY_ORDER.indexOf(b));
const mallCount = new Set(locations.map((l) => l.mall.id)).size;
const cat = brand.category ? categoryName.get(brand.category) : null;
const agent = agents.find((a) => a.id === brand.agent);
const lastSeen = locations.reduce((m, l) => (l.unit.last_seen > m ? l.unit.last_seen : m), '');
---

<Base title={`${brand.name} 櫃位查詢`} description={`${brand.name}在全台 ${mallCount} 個商場設櫃，查看各店所在樓層。`}>
  <article data-pagefind-body data-pagefind-meta={`title:${brand.name}`}>
    <section class="mt-8 flex flex-col gap-5 rounded-3xl border border-line bg-card p-6 sm:flex-row sm:items-center">
      <BrandAvatar name={brand.name} size="lg" />
      <div class="min-w-0 flex-1">
        <h1 class="text-3xl font-black" data-pagefind-weight="10">{brand.name}</h1>
        {brand.name_zh && <p class="text-muted">{brand.name_zh}</p>}
        <div class="mt-3 flex flex-wrap gap-2 text-xs">
          <span class="rounded-full bg-brand-soft px-3 py-1 font-bold text-brand">{cat ? `${cat.icon} ${cat.name}` : '分類建置中'}</span>
          {agent && <a href={`/agents/${agent.id}/`} class="rounded-full bg-paper px-3 py-1">代理商：{agent.name}</a>}
          {brand.review === 'pending' && <span class="rounded-full bg-paper px-3 py-1 text-muted">品牌資料待審核</span>}
        </div>
      </div>
      <div class="rounded-2xl bg-paper p-4 text-center">
        <b class="block text-3xl font-black text-brand">{mallCount}</b>
        <span class="text-xs text-muted">個商場有櫃</span>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="mb-4 text-xl font-black">在哪裡可以找到 {brand.name}？</h2>
      {
        cities.map((city) => (
          <div class="mb-6">
            <h3 class="mb-2 text-sm font-bold text-muted">{city}</h3>
            <ul class="grid gap-2 sm:grid-cols-2">
              {byCity.get(city)!.map((l) => (
                <li>
                  <a href={`/malls/${l.mall.id}/`} class="flex items-center justify-between gap-3 rounded-2xl border border-line bg-card p-4 transition hover:border-brand">
                    <span>
                      <b class="block">{l.mall.name}</b>
                      <span class="text-xs text-muted">{l.mall.district}・{l.mall.address}</span>
                    </span>
                    <span class="shrink-0 rounded-xl bg-brand-soft px-3 py-1 text-sm font-black text-brand">
                      {l.mall.buildings.length > 1 && `${l.building.name} `}{l.floor.label}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="text-xs text-muted">資料最後確認：{lastSeen}・櫃位異動以商場官網公告為準</p>
    </section>
  </article>
</Base>
